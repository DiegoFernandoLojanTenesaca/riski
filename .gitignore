.venv/
__pycache__/
*.pyc
*.log

# El dataset vive en C:, no en el repo. Se reconstruye con datos.py.
datos/
*.jpg
*.png
!icono.svg

# Los pesos de entrenamiento y el modelo sin cuantizar no van al repo: son
# 14 y 13 MB que nadie necesita para abrir la web.
*.pt
*.pth
*.onnx
*.onnx.data

# Salvo lo que la web necesita para funcionar en GitHub Pages. Sin estas
# excepciones se publica una página incapaz de cargar su propio modelo.
!docs/modelo/riksi-int8.onnx
!docs/modelo-audio/riksi-audio-fp16.onnx
!docs/catalogo/*.jpg
!docs/prueba/*.jpg
!docs/portada.jpg

# El banco de medición se genera en local y no se publica: son megas que solo
# sirven para comparar el navegador con Python.
docs/banco/

# El paquete de WebGPU son 28 MB de wasm. Se prueba en local; solo entra al
# repositorio si la medición justifica doblar la descarga.
docs/vendor/*jsep*
docs/vendor/ort.webgpu.min.js

# La clave de la API de xeno-canto nunca va al repositorio: la revocan si
# aparece publicada.
xc-clave.txt

# Indice de CodeGraph: se regenera, no se versiona.
.codegraph/

# MLflow: el registro se regenera de los metricas.json.
mlflow.db
mlruns/
